---
// Header controls: accent colour, then Starlight's dark/light select.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import { PALETTES } from '../lib/site';
---
<div class="learn-tools">
  <div class="pal" role="group" aria-label="Accent colour">
    {PALETTES.map((p) => <button type="button" class={`pal-dot pal-${p.id}`} data-learn-palette={p.id} aria-label={p.label} title={p.label}></button>)}
  </div>
  <Default />
</div>
<script>
  import { initLearn } from '../scripts/learn';
  initLearn();
</script>
