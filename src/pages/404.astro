---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div style="text-align:center; padding: 80px 0;">
    <p class="mono" style="font-size:13px;color:var(--accent)">404</p>
    <h1 style="font-size:28px;margin:8px 0 12px">This page isn't here.</h1>
    <p style="color:var(--ink-soft);margin-bottom:22px">The lesson may have moved or never existed.</p>
    <a class="btn btn--accent" href="/">← Back to courses</a>
  </div>
</Base>
